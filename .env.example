# Copy this file to .env and change the secrets:   Copy-Item .env.example .env
# Never commit the real .env file.

# ---------- PostgreSQL ----------
POSTGRES_USER=catdog
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=catdog
# Port on YOUR PC that maps to the database container (5432 is often taken).
POSTGRES_HOST_PORT=5433
# Used by the backend when running on your PC. (Inside Docker Compose the
# backend uses host "db" and port 5432 instead - set in docker-compose.yml.)
DATABASE_URL=postgresql+psycopg://catdog:change-me-db-password@127.0.0.1:5433/catdog

# ---------- Security ----------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true in production (HTTPS only). false for local http://localhost development.
COOKIE_SECURE=false

# ---------- App ----------
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# Leave empty to use the threshold tuned during training (stored in the model file).
CONFIDENCE_THRESHOLD=
LOG_LEVEL=INFO

# ---------- Docker deployment (Caddy) ----------
# localhost             -> https://localhost on this PC (local certificate)
# 192.168.x.x           -> HTTPS for phones on your Wi-Fi (local certificate)
# cats.example.com      -> real Let's Encrypt certificate on a cloud server
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
